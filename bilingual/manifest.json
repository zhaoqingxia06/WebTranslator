{
  "manifest_version": 3,
  "name": "Side Translate",
  "version": "0.6.8",
  "description": "网页双栏翻译与同步阅读",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Side Translate",
    "default_icon": {
      "16": "folio-16.png",
      "32": "folio-32.png",
      "48": "folio-48.png",
      "128": "folio-128.png"
    }
  },
  "icons": {
    "16": "folio-16.png",
    "32": "folio-32.png",
    "48": "folio-48.png",
    "128": "folio-128.png"
  }
}
